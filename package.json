{
  "name": "swan-hrms",
  "version": "0.1.0",
  "private": true,
  "description": "HRMS modernization — NestJS + Prisma + PostgreSQL (phase-2 scaffold; legacy repo remains a read-only reference)",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "db:seed": "npm run prisma:migrate:dev && npm run prisma:seed",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@nestjs/cli": "^9.5.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/node": "^14.18.63",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/winston": "^2.4.4",
    "prisma": "^4.16.2",
    "rimraf": "^3.0.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@nestjs/common": "^9.4.3",
    "@nestjs/config": "^2.3.4",
    "@nestjs/core": "^9.4.3",
    "@nestjs/jwt": "^9.0.0",
    "@nestjs/passport": "^9.0.3",
    "@nestjs/platform-express": "^9.4.3",
    "@nestjs/schedule": "^2.2.3",
    "@nestjs/swagger": "^6.3.0",
    "@prisma/client": "^4.16.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "helmet": "^6.2.0",
    "nodemailer": "^10.3.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "engines": {
    "node": "18.x",
    "note": "Pinned to Node 18 LTS for Vercel services compatibility."
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
